# RadAxis Mobile — Environment Configuration Template
# Copy this file to .env for local development

# Base URL of the RadAxis RIS REST API Gateway
# Production Gateway: https://meril-ris.mangesh.my.id/api/v1
# Local Development: http://localhost:5005/api/v1
EXPO_PUBLIC_API_BASE_URL=https://meril-ris.mangesh.my.id/api/v1

# Target Environment: 'production' | 'staging'
EXPO_PUBLIC_APP_ENV=production

# Development Preview Mode (strictly disabled in release builds)
EXPO_PUBLIC_DEV_PREVIEW_MODE=false
